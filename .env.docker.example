# Salin ke .env di server: cp .env.docker.example .env
# Minimal yang WAJIB diisi: APP_URL dan DB_PASSWORD.

APP_NAME="Asset Kantorku"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Kosongkan untuk dibuat otomatis (disimpan di volume storage).
# Atau isi sendiri: docker compose run --rm app php artisan key:generate --show
APP_KEY=

# Port di host yang dibuka ke luar
APP_PORT=80

# Database (container "db" dibuat otomatis oleh docker-compose)
DB_DATABASE=asset_kantorku
DB_USERNAME=assetkantorku
DB_PASSWORD=

# Jalankan migration otomatis saat container start
RUN_MIGRATIONS=true
# true = isi data RBAC + akun demo (password: "password") saat DB masih kosong.
# Aman diulang, tapi SEGERA ganti password & nonaktifkan akun demo setelah login.
RUN_SEED=false

LOG_CHANNEL=stderr
LOG_LEVEL=warning

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12
